# Copy to .env and fill in real values. Never commit .env.

TELEGRAM_BOT_TOKEN=your_new_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# From the-odds-api.com (NOT theoddsapi.com — different, unrelated service)
ODDS_API_KEY=your_odds_api_key_here

# Optional overrides (defaults shown)
DEFAULT_TOTAL_STAKE=1000
MIN_ROI_PCT=2.0
POLL_INTERVAL_SECONDS=120
ALERT_COOLDOWN_SECONDS=600

# ── Basketball sibling bot (separate Telegram bot — get a new one via
# @BotFather, same process, don't reuse the football bot's token) ────────
BASKETBALL_TELEGRAM_BOT_TOKEN=your_basketball_bot_token_here
BASKETBALL_TELEGRAM_CHAT_ID=your_basketball_chat_id_here
BASKETBALL_DEFAULT_TOTAL_STAKE=1000
BASKETBALL_MIN_ROI_PCT=2.0
BASKETBALL_POLL_INTERVAL_SECONDS=120
